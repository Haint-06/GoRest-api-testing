        {
          "name": "Request_6",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 422\", () => pm.response.to.have.status(422));\r",
                  "pm.test(\"Báo lỗi email đã tồn tại\", () => {\r",
                  "  const err = pm.response.json().find(e => e.field === \"email\");\r",
                  "  pm.expect(err).to.exist;\r",
                  "  pm.expect(err.message).to.include(\"already been taken\");\r",
                  "});\r",
                  "\r",
                  "const seedId = pm.environment.get(\"seedUserId\");\r",
                  "if (seedId) {\r",
                  "  pm.sendRequest({\r",
                  "    url: pm.environment.get(\"base_url\") + \"/users/\" + seedId,\r",
                  "    method: \"DELETE\",\r",
                  "    header: { \"Authorization\": \"Bearer \" + pm.environment.get(\"token\") }\r",
                  "  }, () => pm.environment.unset(\"seedUserId\"));\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({\r",
                  "  url: pm.environment.get(\"base_url\") + \"/users\",\r",
                  "  method: \"POST\",\r",
                  "  header: {\r",
                  "    \"Authorization\": \"Bearer \" + pm.environment.get(\"token\"),\r",
                  "    \"Content-Type\": \"application/json\"\r",
                  "  },\r",
                  "  body: {\r",
                  "    mode: \"raw\",\r",
                  "    raw: JSON.stringify({\r",
                  "      name: \"Dup Seed\",\r",
                  "      gender: \"male\",\r",
                  "      email: pm.environment.get(\"userEmail\"),\r",
                  "      status: \"active\"\r",
                  "    })\r",
                  "  }\r",
                  "}, (err, res) => {\r",
                  "  if (!err && res.code === 201) {\r",
                  "    pm.environment.set(\"seedUserId\", res.json().id);\r",
                  "  }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
