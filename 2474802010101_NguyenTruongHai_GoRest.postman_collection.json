            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code là 201\", () => pm.response.to.have.status(201));\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "  const res = pm.response.json();\r",
                  "  pm.environment.set(\"userId\", res.id);\r",
                  "  pm.environment.set(\"userEmail\", res.email);\r",
                  "\r",
                  "  pm.test(\"Email trả về khớp với dòng CSV\", () => {\r",
                  "    pm.expect(res.email).to.eql(pm.iterationData.get(\"email\"));\r",
                  "  });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
